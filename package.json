{
  "name": "projispace-local",
  "version": "1.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "desktop/main.mjs",
  "description": "A local workspace for projects, plans and references.",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run notices:check && tsc -b && vite build",
    "start": "node server/index.mjs",
    "test": "node --test server/*.test.mjs src/*.test.mjs desktop/*.test.mjs",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --win --x64 --dir",
    "desktop:build": "npm run desktop:build:win",
    "desktop:test": "npm run build && node scripts/test-desktop.mjs",
    "notices": "node scripts/third-party-notices.mjs",
    "notices:check": "node scripts/third-party-notices.mjs --check",
    "desktop:build:win": "npm run build && electron-builder --win --x64 --publish never",
    "desktop:build:mac": "npm run build && electron-builder --mac --x64 --arm64 --publish never"
  },
  "dependencies": {
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "dompurify": "^3.4.17",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "author": "pl.workshop",
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  }
}
